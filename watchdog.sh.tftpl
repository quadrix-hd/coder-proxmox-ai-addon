#!/bin/bash
export PATH="/root/.local/bin:$PATH"
if [ -f /etc/coder-agent.env ]; then
  set -a
  . /etc/coder-agent.env
  set +a
fi
if [ -f /tmp/start.sh ] && ! curl -fs -o /dev/null http://localhost:3284/status; then
  cd /home/coder/project && AGENTAPI_CHAT_BASE_PATH='${chat_base_path}' AGENTAPI_ALLOWED_HOSTS='*' ARG_WORKDIR=/home/coder/project nohup /tmp/start.sh > /tmp/watchdog-restart.log 2>&1 &
fi
