# cp .env.example .env und mit echten Werten fuellen. .env ist in
# .gitignore und wird nie committet.

# Zufälligen Wert erzeugen, z.B.: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Passwort-Hash fuer den Admin-Login erzeugen (im admin-ui/-Ordner):
#   docker compose run --rm admin-ui python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('DEIN-PASSWORT'))"
# WICHTIG: in EINFACHEN Anfuehrungszeichen eintragen - der Hash enthaelt
# '$'-Zeichen, die Docker Compose sonst als Variablen interpretiert und
# dabei kaputt macht (Login schlaegt dann auch mit richtigem Passwort fehl).
ADMIN_UI_PASSWORD_HASH='scrypt:...'

# API-Token, mit dem die "Go live"-App in den Dev-Workspaces die Admin-UI
# beauftragt. Zufaelligen Wert erzeugen wie bei SECRET_KEY; derselbe Wert
# kommt als golive_admin_ui_token in die terraform.tfvars des Haupttemplates.
ADMIN_UI_API_TOKEN=

# Wie dieser Dienst von Dev-Workspaces aus erreichbar ist (fuer die
# status_url-Antwort auf POST /api/sites). z.B. http://10.0.75.1:9000
ADMIN_UI_PUBLIC_URL=

# Proxmox - dieselben Werte wie im Haupttemplate, siehe terraform.tfvars.example
PM_API_URL=https://10.0.10.2:8006/api2/json
PM_API_TOKEN_ID=root@pam!terraform
PM_API_TOKEN_SECRET=
PM_TLS_INSECURE=false
TARGET_NODE=pve

LXC_SUBNET=10.0.75
LXC_GATEWAY=10.0.75.1
LXC_VLAN_TAG=75
# Storage fuer die Produktions-LXCs (z.B. Ceph-RBD-Pool)
LXC_STORAGE=local-lvm

# Private Registry, siehe ../registry/README.md
REGISTRY_URL=10.0.75.1:5000
REGISTRY_USER=golive
REGISTRY_PASSWORD=

# Optional: Pangolin Integration API fuer automatische Site/Resource-
# Erstellung. Alle drei leer lassen, um stattdessen die Newt-Site weiter
# manuell in Pangolins WebUI anzulegen (siehe README). UNVERIFIZIERT gegen
# eine echte Pangolin-Instanz - siehe app/pangolin_client.py, Kommentar oben.
PANGOLIN_API_URL=
PANGOLIN_API_KEY=
PANGOLIN_ORG_ID=
PANGOLIN_NEWT_ENDPOINT=
